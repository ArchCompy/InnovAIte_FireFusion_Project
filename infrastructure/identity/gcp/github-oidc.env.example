# GCP GitHub Workload Identity Federation configuration
# No service-account JSON key should be used.

GCP_PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID
GCP_PROJECT_NUMBER=REPLACE_WITH_GCP_PROJECT_NUMBER

GCP_WORKLOAD_IDENTITY_POOL=firefusion-github-pool
GCP_WORKLOAD_IDENTITY_PROVIDER=firefusion-github-provider

GCP_SERVICE_ACCOUNT=REPLACE_WITH_SERVICE_ACCOUNT@REPLACE_WITH_PROJECT_ID.iam.gserviceaccount.com

# GitHub identity scope
GITHUB_ORGANIZATION=InnovAIte-Deakin
GITHUB_REPOSITORY=InnovAIte_FireFusion_Project
GITHUB_BRANCH=main
