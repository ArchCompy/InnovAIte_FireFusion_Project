# AWS GitHub OIDC configuration
# No AWS access key or secret access key is required.

AWS_REGION=REPLACE_WITH_AWS_REGION
AWS_ACCOUNT_ID=REPLACE_WITH_AWS_ACCOUNT_ID

# IAM role assumed by GitHub Actions
AWS_GITHUB_ROLE_ARN=arn:aws:iam::REPLACE_WITH_ACCOUNT_ID:role/firefusion-github-actions

# GitHub identity scope
GITHUB_ORGANIZATION=InnovAIte-Deakin
GITHUB_REPOSITORY=InnovAIte_FireFusion_Project
GITHUB_BRANCH=main
